{
  "expo": {
    "name": "PhysioHub Admin",
    "slug": "physio-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1a365d",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.tricityphysiohub.admin",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a365d"
      },
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#1a365d"
      },
      "intentFilters": [],
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "RECEIVE_SMS",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      ["expo-notifications", { "color": "#1a365d" }],
      ["expo-secure-store"]
    ],
    "extra": {
      "apiUrl": "https://tricityphysiohub.in"
    }
  }
}
